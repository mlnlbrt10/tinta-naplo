# E-Kréta CLI Test Script Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# Institution short code (iss), e.g. "klik035220001" or "bp-fazekas"
# Use "firka-test" when testing against a local mock_kreta_server instance.
KRETA_INSTITUTION_ID=

# Student username (typically 11-digit educational ID / oktatási azonosító)
KRETA_USERNAME=

# Student password
KRETA_PASSWORD=

# Optional: Override IDP/API base URL (e.g. http://127.0.0.1:8090 for mock_kreta_server)
# MOCK_KRETA_SERVER_URL=
